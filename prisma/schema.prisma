// Costume sizing: accounts and saved shows.
//
// The sizing itself needs no database - anyone can upload a sheet and size it
// without signing in. This stores work for signed-in users only: a show (one
// upload, e.g. "Christmas 2026") holds its classes, and every override is kept
// as a history entry so the original recommendation and who changed it, when
// and why are never lost.
//
// One studio for now: every account sees every show. Accounts are created with
// `npm run user:create`; there is no public sign-up.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         UserRole @default(STAFF)
  /// scrypt hash with its salt; see src/lib/auth/password.ts.
  passwordHash String
  createdAt    DateTime @default(now())

  sessions       Session[]
  showsCreated   Show[]          @relation("ShowCreatedBy")
  classesUpdated SavedClass[]    @relation("ClassUpdatedBy")
  overrides      OverrideEvent[]
}

enum UserRole {
  ADMIN
  STAFF
}

/// A signed-in browser. Only a SHA-256 of the cookie's token is stored, so a
/// leaked database cannot be used to sign in.
model Session {
  id        String   @id // sha256(token), hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One upload saved under a name, e.g. "Christmas 2026" or "Spring Recital".
model Show {
  id             String       @id @default(cuid())
  name           String
  sourceFileName String
  sourceFileKind String // xlsx | csv | pdf
  createdById    String
  createdBy      User         @relation("ShowCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  classes        SavedClass[]
}

/// One class of a show, as it stands on screen.
model SavedClass {
  id        String @id @default(cuid())
  showId    String
  show      Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
  /// The tab the class came from; a class's identity within its show.
  sheetName String
  className String
  position  Int

  /// The class as uploaded (tab metadata, dancers, measurements). Never changed,
  /// so edits in the app can always be compared with what the sheet said.
  original Json
  /// Current dancers (including edits and additions), costume groups and pieces
  /// with their looked-up costume data, charts, colours, and who wears the
  /// boys' costume.
  state    Json
  /// The latest sizing: recommended sizes, flags, skipped dancers, charts used.
  results  Json?
  /// Current overrides, keyed by dancer row and costume piece.
  overrides Json @default("{}")

  sizedAt     DateTime?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   User?     @relation("ClassUpdatedBy", fields: [updatedById], references: [id])

  overrideEvents OverrideEvent[]

  @@unique([showId, sheetName])
}

/// Every change to an override, in order. The current override is the latest
/// event for a dancer and piece; earlier ones are the history.
model OverrideEvent {
  id          String     @id @default(cuid())
  classId     String
  savedClass  SavedClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  rowNumber   Int
  dancerName  String
  styleNumber String
  /// What the app recommended at the time.
  recommendedSize String
  /// The size chosen instead; null when an override was removed.
  toSize      String?
  reason      String?
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  createdAt   DateTime   @default(now())

  @@index([classId, createdAt])
}
